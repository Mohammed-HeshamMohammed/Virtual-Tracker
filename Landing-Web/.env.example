# Copy to .env.local for local dev (never commit .env.local).

# -----------------------------------------------------------------------------
# COOLIFY / PRODUCTION ENVIRONMENT VARIABLES:
# -----------------------------------------------------------------------------
#
# 1. PORT (Regular Environment Variable)
#    - Forces the application container to listen on the correct port (3001).
#    - In Coolify, ensure this is added in the Environment Variables tab.
PORT=3001

# 2. NEXT_PUBLIC_DASHBOARD_URL (Build-time Environment Variable)
#    - Point to the Dashboard Web application URL so CTAs redirect correctly.
#    - IMPORTANT: In Coolify, you must check the "Build Variable" option for this
#      variable so Next.js can embed it in the static files during build time.
#    - Local Dev:  http://localhost:3000
#    - Production: https://app.myvirtualtracker.com
NEXT_PUBLIC_DASHBOARD_URL=https://app.myvirtualtracker.com

# 3. NEXT_PUBLIC_LANDING_API_URL (Build-time Environment Variable)
#    - Landing-Backend origin — handles the contact form and the passive
#      cross-domain "already signed in on Dashboard-Web?" cookie check.
#    - Same Coolify "Build Variable" requirement as above.
#    - Local Dev:  http://localhost:5714
#    - Production: https://api.myvirtualtracker.com
NEXT_PUBLIC_LANDING_API_URL=https://api.myvirtualtracker.com

# 4. NEXT_PUBLIC_AUTH_API_URL / NEXT_PUBLIC_DASHBOARD_API_URL (Build-time)
#    - Required for Landing-Web's own sign-in/sign-up and account area
#      (/sign-in, /account/*). These are Bearer-token APIs with wildcard CORS,
#      so Landing-Web calls Auth-Backend and Dashboard-Backend directly here —
#      same pattern Dashboard-Web uses, not proxied through Landing-Backend.
#    - Same Coolify "Build Variable" requirement as above.
#    - Local Dev:  http://localhost:5712 / http://localhost:5713
#    - Production: https://appapi.myvirtualtracker.com (see your Auth/Dashboard
#      Backend's actual routing — these may be the same host with path routing)
NEXT_PUBLIC_AUTH_API_URL=https://appapi.myvirtualtracker.com
NEXT_PUBLIC_DASHBOARD_API_URL=https://appapi.myvirtualtracker.com

