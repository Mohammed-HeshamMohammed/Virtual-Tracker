# Dashboard-Backend — identity & app routes (vt-dashboard-api)
# Copy to Dashboard-Backend/.env (never commit .env).
#
# Owns: session-bootstrap, profile, member/project/task/client/team data,
#       activity, presence, org hierarchy, invites, bootstrap.
# Does NOT own: firebase-config, password-policy, validate-password, verify,
#               resolve-sign-in-methods, auth/readiness — Auth-Backend only.
# Will NOT own (after vt-notify-api extraction): email, OTP, push.
#
# Blast radius: a breach here exposes Firestore data but NOT messaging credentials
# once RESEND_API_KEY / VAPID key have moved to vt-notify-api.
#
# Firebase Admin files (alternative to FIREBASE_* env vars below):
#   firebase-admin.local.json  ← copy from firebase-admin.local.json.example
#
# Rate limits (code defaults — not env vars): src/http/rate-limit.js

# ── Local DEV ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5713

# CORS — browser origins allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
# Optional override (defaults include Dashboard + Landing on :3000 / :3001 and 127.0.0.1)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ── Outbound messaging — TEMPORARY (remove once vt-notify-api is live) ────────
#
# These credentials increase blast radius. Once vt-notify-api is deployed and
# identity-routes.js email handlers + notifications module are migrated,
# delete all vars in this block and set NOTIFY_BACKEND_URL instead.

# RESEND_API_KEY=                          # ⚠️ move to vt-notify-api
# RESEND_FROM=Virtual Tracker <noreply@myvirtualtracker.com>   # ⚠️ move to vt-notify-api
# SMTP_HOST=                               # ⚠️ move to vt-notify-api
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Phone OTP — set to true to use test codes in local dev
PHONE_VERIFICATION_DEV_MODE=false          # ⚠️ move to vt-notify-api

# Web Push
# FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=      # ⚠️ move to vt-notify-api

# ── Internal service auth — add when vt-notify-api is live ───────────────────
# NOTIFY_BACKEND_URL=http://localhost:5715
# INTERNAL_SERVICE_SECRET=

# ── Firebase Admin — required for Firestore access ────────────────────────────
# (prefer firebase-admin.local.json for local dev)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Or single-line JSON:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Firebase Realtime Database (only if Admin SDK requires RTDB URL)
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ── Production (Coolify: DashboardBackend-Prod, vt-dashboard-api, dashapi.myvirtualtracker.com) ──

# NODE_ENV=production
# PORT=3000

# APP_PUBLIC_URL and FRONTEND_ORIGIN must be https in production
# FRONTEND_ORIGIN=https://app.myvirtualtracker.com
# APP_PUBLIC_URL=https://app.myvirtualtracker.com
# CORS_ORIGINS=https://app.myvirtualtracker.com,https://myvirtualtracker.com

# Outbound messaging — present until vt-notify-api extraction is complete:
# RESEND_API_KEY=                          # ⚠️ remove after extraction
# RESEND_FROM=Virtual Tracker <noreply@myvirtualtracker.com>   # ⚠️ remove after extraction
# PHONE_VERIFICATION_DEV_MODE=false        # ⚠️ remove after extraction
# FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=      # ⚠️ remove after extraction

# Internal service auth — set when vt-notify-api is deployed:
# NOTIFY_BACKEND_URL=https://notify.myvirtualtracker.com
# INTERNAL_SERVICE_SECRET=

# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Optional ──────────────────────────────────────────────────────────────────

# ALLOW_INSECURE_HTTP=true          # dev only — disable HTTPS enforcement
# SKIP_ENV_VALIDATION=1              # tests only — skip Zod env check
# GOOGLE_APPLICATION_CREDENTIALS=    # path to service account JSON file
# MONITOR_USERNAME=                   # basic auth for /monitor ops dashboard
# MONITOR_PASSWORD=
# INVITE_SHARE_LINK_TTL_HOURS=48
