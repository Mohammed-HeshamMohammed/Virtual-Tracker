# Dashboard-Backend — identity & app routes (vt-dashboard-api)
# Copy to Dashboard-Backend/.env (never commit .env).
#
# Owns: session-bootstrap, profile, member/project/task/client/team data,
#       activity, presence, org hierarchy, invites, bootstrap.
# Does NOT own: firebase-config, password-policy, validate-password, verify,
#               resolve-sign-in-methods, auth/readiness — Auth-Backend only.
# Does NOT own: email delivery, phone validation, push — Notify-Backend only.
#
# Blast radius: a breach here exposes Firestore data but NOT messaging credentials.
#
# Firebase Admin files (alternative to FIREBASE_* env vars below):
#   firebase-admin.local.json  ← copy from firebase-admin.local.json.example
#
# Rate limits (code defaults — not env vars): src/http/rate-limit.js

# ── Local DEV ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5713

# Frontend origin (used for invite links, emails — CORS itself allows all origins,
# since this API is Bearer-token authenticated and never uses cookies)
FRONTEND_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# ── Sibling services (internal HTTP) ─────────────────────────────────────────

# Auth-Backend — password policy, token verify, firebase-config (browser calls directly)
AUTH_BACKEND_URL=http://localhost:5712

# Notify-Backend — email, phone validation, push (Dashboard calls internally)
NOTIFY_BACKEND_URL=http://localhost:5715
# INTERNAL_SERVICE_SECRET=

# Web Push VAPID public key (served to browser via sign-in-client-extras; FCM send is on Notify-Backend)
# FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=

# ── Firebase Admin — required for Firestore access ────────────────────────────
# (prefer firebase-admin.local.json for local dev)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Or single-line JSON:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Firebase Realtime Database (only if Admin SDK requires RTDB URL)
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Google Cloud Storage (avatars, activity screenshots, task attachments)
# GCS_BUCKET_NAME=vt-development
# Falls back to FIREBASE_STORAGE_BUCKET when unset.

# PostgreSQL (time_entries, timesheets, and static lookups — see src/lib/postgres/schema.sql)
# Lookup tables: roles, lookup_tables, org_field_options (migrate with npm run migrate:lookups-to-postgres)
# Local dev:
# POSTGRES_URL=postgresql://user:password@localhost:5432/virtual_tracker

# ── Production (Coolify: DashboardBackend-Prod, vt-dashboard-api, dashapi.myvirtualtracker.com) ──

# NODE_ENV=production
# PORT=3000

# APP_PUBLIC_URL and FRONTEND_ORIGIN must be https in production
# FRONTEND_ORIGIN=https://app.myvirtualtracker.com
# APP_PUBLIC_URL=https://app.myvirtualtracker.com

# AUTH_BACKEND_URL=https://auth.myvirtualtracker.com
# NOTIFY_BACKEND_URL=https://notify.myvirtualtracker.com
# INTERNAL_SERVICE_SECRET=

# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# PostgreSQL — use the Coolify **Postgres URL (internal)** so traffic stays on the private
# Docker network (never the public URL). Copy it verbatim from the Coolify Postgres resource
# page. The host is the DB service name/UUID, NOT localhost, and vt-dashboard-api must share
# the same Coolify project/network as the database.
#   POSTGRES_URL=postgres://postgres:<password>@<db-internal-hostname>:5432/<database>
# Example:
#   POSTGRES_URL=postgres://postgres:s3cret@postgresql-database-abc123:5432/postgres

# ── Optional ──────────────────────────────────────────────────────────────────

# ALLOW_INSECURE_HTTP=true          # dev only — disable HTTPS enforcement
# SKIP_ENV_VALIDATION=1              # tests only — skip Zod env check
# GOOGLE_APPLICATION_CREDENTIALS=    # path to service account JSON file
# MONITOR_USERNAME=                   # basic auth for /monitor ops dashboard
# MONITOR_PASSWORD=
# INVITE_SHARE_LINK_TTL_HOURS=48

# Google Cloud Storage (avatars, activity screenshots, task attachments)
# GCS_BUCKET_NAME=vt-development
# Falls back to FIREBASE_STORAGE_BUCKET when unset.