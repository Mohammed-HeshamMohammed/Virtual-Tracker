{
  "name": "virtual-tracker-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --use-system-ca index.js",
    "dev": "node scripts/dev-watch.mjs",
    "deploy:firestore": "npx -y firebase-tools@latest deploy --only firestore:rules,firestore:indexes",
    "deploy:storage": "npx -y firebase-tools@latest deploy --only storage",
    "firebase:login": "npx -y firebase-tools@latest login",
    "firebase:deploy-hosting": "npx -y firebase-tools@latest deploy --only hosting",
    "lint:config": "node scripts/lint-env-access.mjs && node scripts/lint-mobile-collections.mjs",
    "assign-owner": "node --use-system-ca --env-file-if-exists=.env scripts/assign-owner.mjs",
    "verify-user-email": "node --use-system-ca --env-file-if-exists=.env scripts/verify-user-email.mjs",
    "migrate:profile-images": "node --use-system-ca --env-file-if-exists=.env scripts/migrate-profile-images.mjs",
    "migrate:strip-role-names": "node --use-system-ca --env-file-if-exists=.env scripts/strip-member-role-names.mjs",
    "migrate:clean-presence": "node --use-system-ca --env-file-if-exists=.env scripts/clean-member-presence.mjs",
    "migrate:phone-verification": "node --use-system-ca --env-file-if-exists=.env scripts/migrate-phone-verification.mjs",
    "migrate:client-budget-start-date": "node --use-system-ca --env-file-if-exists=.env scripts/migrate-client-budget-start-date.mjs",
    "migrate:to-postgres": "node --use-system-ca --env-file-if-exists=.env scripts/migrate-to-postgres.mjs",
    "migrate:lookups-to-postgres": "node --use-system-ca --env-file-if-exists=.env scripts/migrate-lookups-to-postgres.mjs",
    "sync:firebase-local": "node scripts/sync-firebase-local.mjs",
    "sync:firebase-web": "node scripts/sync-firebase-local.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "ioredis": "^5.11.1",
    "pg": "^8.16.3",
    "sharp": "^0.34.3",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "protobufjs": ">=7.5.5",
    "@tootallnate/once": ">=3.0.0",
    "http-proxy-agent": ">=7.0.0",
    "teeny-request": ">=9.0.0",
    "uuid": ">=14.0.0",
    "google-gax": ">=4.6.0"
  }
}
