# Landing-Backend — contact form + landing-page session-status proxy (vt-landing-api)
# Copy to Landing-Backend/.env (never commit .env).
#
# Owns: POST /api/contact (persists to Firestore + notifies support via Notify-Backend),
#       GET /api/session-status and POST /api/session-logout (proxy Dashboard-Backend's
#       shared session cookie so Landing-Web never has to call another origin directly).
#
# Firebase Admin file (alternative to FIREBASE_* env vars below):
#   firebase-admin.local.json  ← copy from Auth-Backend/firebase-admin.local.json.example
#
# Rate limits (code defaults — not env vars): src/http/rate-limit.js
#   /api/contact → 5 req/min/IP; session-status/logout → 120 req/min/IP; loopback exempt in dev

# ── Local DEV ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5714

FRONTEND_ORIGIN=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3001

# Dashboard-Backend — session-status/session-logout proxy target
DASHBOARD_BACKEND_URL=http://localhost:5713

# Notify-Backend — sends the "new contact inquiry" email to SUPPORT_EMAIL below
NOTIFY_BACKEND_URL=http://localhost:5715
# INTERNAL_SERVICE_SECRET=
# SUPPORT_EMAIL=support@myvirtualtracker.com

# Firebase Admin — required to persist contact form submissions to Firestore
# (prefer firebase-admin.local.json for local dev)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Or single-line JSON:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Production (Coolify: branch LandingWebBackend-Prod, vt-landing-api) ──

# NODE_ENV=production
# PORT=3000

# APP_PUBLIC_URL and FRONTEND_ORIGIN must be https in production
# FRONTEND_ORIGIN=https://myvirtualtracker.com
# APP_PUBLIC_URL=https://myvirtualtracker.com

# DASHBOARD_BACKEND_URL=https://appapi.myvirtualtracker.com
# NOTIFY_BACKEND_URL=https://notify.myvirtualtracker.com
# INTERNAL_SERVICE_SECRET=
# SUPPORT_EMAIL=support@myvirtualtracker.com

# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Optional ──────────────────────────────────────────────────────────────────

# ALLOW_INSECURE_HTTP=true          # dev only — disable HTTPS enforcement
# SKIP_ENV_VALIDATION=1              # tests only — skip Zod env check
# GOOGLE_APPLICATION_CREDENTIALS=    # path to service account JSON file
