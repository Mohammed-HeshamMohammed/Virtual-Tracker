# Ignore everything in root except Dashboard-Web and .gitignore
/*
!/Dashboard-Web
!.gitignore

# Dependencies
node_modules/
**/node_modules/
jspm_packages/
.pnpm-store/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Environment and secret files
.env
.env.*
!.env.example
*.env
*.local.json
firebase-admin.local.json
firebase-web.local.json
*.local
*.pem
*.key
*.crt

# Operating System files
.DS_Store
Thumbs.db

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# Testing
coverage/
.nyc_output/
*.lcov

# Build and generated output
dist/
build/
.next/
out/
.vercel/
.firebase/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.pid

# Local databases and backups
*.sqlite
*.db
*.bak
