# Notify-Backend — outbound messaging service (vt-notify-api)
# Copy to Notify-Backend/.env (never commit .env).
#
# INTERNAL ONLY — no browser ever calls this service directly.
# Only vt-dashboard-api and vt-landing-api reach it, via INTERNAL_SERVICE_SECRET.
#
# Owns: email delivery (SMTP only), phone validation (libphonenumber-js), FCM Push
# Notifications, and the destination inbox for the landing page's contact form.
# Does NOT own: Firestore, user identity.
#
# Blast radius benefit: a breach of Dashboard-Backend cannot send
# phishing email to users — those credentials live only here.

# ── Local DEV ─────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5715

# Internal shared secret — Dashboard-Backend must send this in Authorization header.
# Leave blank in local dev to skip auth (a warning will be logged).
# INTERNAL_SERVICE_SECRET=

# CORS — set to Dashboard-Backend's dev origin
FRONTEND_ORIGIN=http://localhost:5713

# ── Email delivery (SMTP only) ────────────────────────────────────────────────

# SMTP (Gmail / Outlook / SendGrid SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Virtual Tracker <you@gmail.com>

# ── Firebase Admin — required for FCM Push Notifications ──────────────────────

# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Or path to json credential file:
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Delivery log (optional) ───────────────────────────────────────────────────
# PostgreSQL table for send deduplication + audit trail (see src/lib/postgres/schema.sql)
# Local dev:
# POSTGRES_URL=postgresql://user:password@localhost:5432/virtual_tracker

# ── Contact form (landing page, via Landing-Backend) ─────────────────────────
# Destination inbox for the "contact-inquiry" template. Without it, inquiries
# still get logged to POSTGRES_URL above (delivery status "failed", metadata
# retained) but no one gets emailed.
# SUPPORT_EMAIL=support@myvirtualtracker.com

# ── Production (Coolify: NotifyBackend-Prod, vt-notify-api, notify.myvirtualtracker.com) ──

# NODE_ENV=production
# PORT=3000

# INTERNAL_SERVICE_SECRET=           # required in production
# FRONTEND_ORIGIN=https://appapi.myvirtualtracker.com

# SMTP configuration
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# SUPPORT_EMAIL=support@myvirtualtracker.com

# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Delivery log DB — use the Coolify **Postgres URL (internal)** so traffic stays on the
# private Docker network (never the public URL). Copy it verbatim from the Coolify
# Postgres resource page. The host is the DB service name/UUID, NOT localhost, and the
# Notify-Backend app must share the same Coolify project/network as the database.
#   POSTGRES_URL=postgres://postgres:<password>@<db-internal-hostname>:5432/<database>
# Example:
#   POSTGRES_URL=postgres://postgres:s3cret@postgresql-database-abc123:5432/postgres
