# Notify-Backend — outbound messaging service (vt-notify-api)
# Copy to Notify-Backend/.env (never commit .env).
#
# INTERNAL ONLY — no browser ever calls this service directly.
# Only vt-dashboard-api reaches it via INTERNAL_SERVICE_SECRET.
#
# Owns: email delivery (SMTP only), OTP/SMS, FCM Push Notifications.
# Does NOT own: Firestore, user identity.
#
# Blast radius benefit: a breach of Dashboard-Backend cannot send
# phishing email or SMS to users — those credentials live only here.

# ── Local DEV ─────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5715

# Internal shared secret — Dashboard-Backend must send this in Authorization header.
# Leave blank in local dev to skip auth (a warning will be logged).
# INTERNAL_SERVICE_SECRET=

# CORS — set to Dashboard-Backend's dev origin
FRONTEND_ORIGIN=http://localhost:5713

# ── Email delivery (SMTP only) ────────────────────────────────────────────────

# SMTP (Gmail / Outlook / SendGrid SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Virtual Tracker <you@gmail.com>

# ── OTP / Phone ───────────────────────────────────────────────────────────────

# Set to true to log OTP codes to console instead of sending real SMS
PHONE_VERIFICATION_DEV_MODE=true

# SMS provider credentials (add when integrating Twilio / Vonage / etc.)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1234567890

# ── Firebase Admin — required for FCM Push Notifications ──────────────────────

# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Or path to json credential file:
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Production (Coolify: NotifyBackend-Prod, vt-notify-api, notify.myvirtualtracker.com) ──

# NODE_ENV=production
# PORT=3000

# INTERNAL_SERVICE_SECRET=           # required in production
# FRONTEND_ORIGIN=https://dashapi.myvirtualtracker.com

# SMTP configuration
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# PHONE_VERIFICATION_DEV_MODE=false

# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
