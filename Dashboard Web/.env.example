# Dashboard Web — API URLs
#
# Production (Docker / VPS): set in deploy/.env — baked in at image build
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#
# Local split backends (no gateway):
# NEXT_PUBLIC_AUTH_API_URL=http://127.0.0.1:5712
# NEXT_PUBLIC_DASHBOARD_API_URL=http://127.0.0.1:5713
#
# If unset in dev, auth → :5712 and dashboard → :5713 automatically.
