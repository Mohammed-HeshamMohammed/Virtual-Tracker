# Virtual-Tracker — full stack (API + app + marketing)
#
# Domains (set in deploy/.env):
#   API_DOMAIN         → api.yourdomain.com          (path routing to Auth/Dashboard backends)
#   APP_DOMAIN         → app.yourdomain.com           (Dashboard Web)
#   LANDING_DOMAIN     → yourdomain.com               (Landing-Web, or www.yourdomain.com)
#   LANDING_API_DOMAIN → landingapi.yourdomain.com    (Landing-Backend — contact form + session-status proxy)

# ── API gateway (Auth + Dashboard backends) ─────────────────────────────────
{$API_DOMAIN} {
	encode gzip

	@auth_api path_regexp ^/api/(v1/)?auth/(firebase-config|readiness|password-policy|validate-password|verify|resolve-sign-in-methods)$

	handle @auth_api {
		reverse_proxy auth-backend:5712
	}

	@presence_ws path /api/presence/ws
	handle @presence_ws {
		reverse_proxy dashboard-backend:5713
	}

	handle /monitor* {
		reverse_proxy dashboard-backend:5713
	}

	handle /api/* {
		reverse_proxy dashboard-backend:5713
	}

	handle /health {
		respond "ok" 200
	}
}

# ── Dashboard Web (SPA) ─────────────────────────────────────────────────────
{$APP_DOMAIN} {
	encode gzip
	# Chrome Local Network Access — allow loopback fetches from the dashboard origin.
	header Permissions-Policy "loopback-network=(self), local-network=(self)"
	reverse_proxy dashboard-web:3000
}

# ── Landing-Web (marketing) ─────────────────────────────────────────────────
{$LANDING_DOMAIN} {
	encode gzip
	reverse_proxy landing-web:3001
}

# ── Landing-Backend (contact form + session-status proxy) ──────────────────
{$LANDING_API_DOMAIN} {
	encode gzip
	reverse_proxy landing-backend:5714
}
