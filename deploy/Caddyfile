# Virtual-Tracker — full stack (API + app + marketing)
#
# Domains (set in deploy/.env):
#   API_DOMAIN     → api.yourdomain.com   (path routing to backends)
#   APP_DOMAIN     → app.yourdomain.com   (Dashboard Web)
#   LANDING_DOMAIN → yourdomain.com       (Landing-Web, or www.yourdomain.com)

# ── API gateway (Auth + Dashboard backends) ─────────────────────────────────
{$API_DOMAIN} {
	encode gzip

	@auth_api path /api/auth/* /api/v1/auth/*

	handle @auth_api {
		reverse_proxy auth-backend:5712
	}

	@presence_ws path /api/presence/ws
	handle @presence_ws {
		reverse_proxy dashboard-backend:5713
	}

	handle /monitor* {
		reverse_proxy dashboard-backend:5713
	}

	handle /api/* {
		reverse_proxy dashboard-backend:5713
	}

	handle /health {
		respond "ok" 200
	}
}

# ── Dashboard Web (SPA) ─────────────────────────────────────────────────────
{$APP_DOMAIN} {
	encode gzip
	reverse_proxy dashboard-web:3000
}

# ── Landing-Web (marketing) ─────────────────────────────────────────────────
{$LANDING_DOMAIN} {
	encode gzip
	reverse_proxy landing-web:3001
}
