# Virtual-Tracker — full stack Docker Compose
#
# Copy to deploy/.env and fill in values before: docker compose up -d --build

# ── Public hostnames (Caddy obtains TLS automatically on 80/443) ─────────────
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
LANDING_DOMAIN=yourdomain.com

# ── URLs used by apps, CORS, and auth emails ─────────────────────────────────
# Dashboard Web build args — these are baked into the browser bundle at
# `docker compose build` time, NOT read at container runtime. Changing them
# and restarting the container does nothing; you must rebuild the image.
#
# Mode A — unified gateway (one domain, Caddy path-routes to both backends):
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#
# Mode B — separate subdomain per backend (leave NEXT_PUBLIC_API_URL blank/unset
# if you use this mode — it takes priority over the two below when set):
# NEXT_PUBLIC_AUTH_API_URL=https://auth.yourdomain.com
# NEXT_PUBLIC_DASHBOARD_API_URL=https://api.yourdomain.com
#
# Primary dashboard URL (Landing-Web build arg + invite emails)
APP_PUBLIC_URL=https://app.yourdomain.com
FRONTEND_ORIGIN=https://app.yourdomain.com
# Comma-separated — include app + landing origins
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com,https://www.yourdomain.com

NODE_ENV=production

# ── Firebase web (client) — required for /api/auth/firebase-config ───────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
# FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ── Firebase Admin — use ONE of: mounted JSON (see compose) OR env JSON ─────
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or single JSON blob:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Email (Auth-Backend — verification; Dashboard-Backend — invites) ─────────
# RESEND_API_KEY=
# RESEND_FROM=Virtual Tracker <noreply@yourdomain.com>
# Or SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM

# ── Optional (Dashboard-Backend) ─────────────────────────────────────────────
# MONITOR_PASSWORD=change-me
# MONITOR_USERNAME=admin
# ACTIVITY_SCREENSHOTS_ENABLED=true
# ACTIVITY_DESKTOP_AGENT_INGEST_ENABLED=true
