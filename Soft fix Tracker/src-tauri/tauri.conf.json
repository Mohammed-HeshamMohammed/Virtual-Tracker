{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soft Fix Tracker",
  "version": "0.1.0",
  "identifier": "com.softfix.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "title": "Soft Fix Tracker",
      "width": 1440,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 700,
      "resizable": true,
      "decorations": true,
      "theme": "Dark",
      "center": true,
      "backgroundColor": "#0b0f19"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false }
}
