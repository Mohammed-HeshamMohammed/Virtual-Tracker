{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VirtualTrackerAgent",
  "version": "0.2.0",
  "identifier": "com.virtualtracker.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Virtual Callers",
        "width": 320,
        "height": 650,
        "minWidth": 320,
        "minHeight": 600,
        "resizable": false,
        "maximizable": false,
        "visible": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": {
          "red": 6,
          "green": 14,
          "blue": 32,
          "alpha": 255
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../scripts/get-browser-url.ps1",
      "../scripts/get-browser-url-macos.applescript"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENTVENEFERDQwNjFFRTIKUldUaUhnYlVyZFJWN1VXeGFFWmp1cGU4T2pkWlFOS1NZSllFUkNMb2JQaFJiRTdkVmMwSXpvaWkK"
    }
  }
}