rules_version = '2';

// Profile avatars are uploaded via the Backend (Admin SDK). Client direct uploads are denied by default.
service firebase.storage {
  match /b/{bucket}/o {
    match /profile-avatars/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
