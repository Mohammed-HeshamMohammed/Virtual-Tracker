# Copy to Backend/.env — launcher setup does this automatically on first run.

PORT=5712
FRONTEND_ORIGIN=http://localhost:3000

# Firebase Realtime Database
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Firebase Web (public client config) — or use firebase-web.local.json
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# Firebase Admin — prefer Backend/firebase-admin.local.json (see *.example files)

# Email (invite & welcome)
# RESEND_API_KEY=
# RESEND_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
