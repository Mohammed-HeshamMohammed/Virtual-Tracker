# Production — Coolify (container: vt-auth-api, domain: auth.myvirtualtracker.com)
#
# AuthN only — Firebase. No SMTP. Verification email → Dashboard-Backend.

NODE_ENV=production
PORT=3000

FRONTEND_ORIGIN=https://app.myvirtualtracker.com
APP_PUBLIC_URL=https://app.myvirtualtracker.com
# CORS_ORIGINS=https://app.myvirtualtracker.com,https://myvirtualtracker.com

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin — use one method:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
