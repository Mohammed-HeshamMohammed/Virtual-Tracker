# Copy ONE block below into Auth-Backend/.env (never commit .env).
#
# AuthN only — eight routes + /health (see README.md, authn-paths.js).
# No SMTP, Resend, SMS, VAPID, or app email on this service.
# Profile, session-bootstrap, verification email → Dashboard-Backend/.env.example
#
# Firebase files (alternative to FIREBASE_* below):
#   firebase-web.local.json   ← copy from firebase-web.local.json.example
#   firebase-admin.local.json ← copy from firebase-admin.local.json.example
#
# Rate limits (code defaults — not env vars): src/http/rate-limit.js
#   /api/auth/* → 25 req/min/IP; validate-password → 40; loopback exempt in dev

# ── Local DEV ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5712

# Frontend origin (used for links, emails — CORS itself allows all origins,
# since this API is Bearer-token authenticated and never uses cookies)
FRONTEND_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Firebase Web — required for GET /api/auth/firebase-config (unless firebase-web.local.json)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# Firebase Admin — required for verify, resolve-sign-in-methods, readiness
# (unless firebase-admin.local.json or GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Or single-line JSON:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Desktop-agent "Continue with Google" one-hop flow (GET /api/auth/google/start,
# /api/auth/google/callback — see src/modules/auth/google-oauth.js). All four
# required together, or the feature responds agentLinkError=not_configured.
# GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET come from a *separate*
# OAuth 2.0 Client ID (Web application type) created in Google Cloud Console —
# NOT Firebase's own auto-provisioned client — with GOOGLE_OAUTH_REDIRECT_URI
# registered as its one authorized redirect URI.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5712/api/auth/google/callback
# GOOGLE_OAUTH_STATE_SECRET=            # any long random string (openssl rand -hex 32)
# Dashboard-Backend base URL — the callback calls this service's
# /api/activity/agent/link/complete to finish the desktop link session.
# DASHBOARD_API_URL=http://localhost:5713

# ── Production (Coolify: branch Auth-Production, vt-auth-api, auth.myvirtualtracker.com) ──

# NODE_ENV=production
# PORT=3000

# APP_PUBLIC_URL and FRONTEND_ORIGIN must be https in production
# FRONTEND_ORIGIN=https://app.myvirtualtracker.com
# APP_PUBLIC_URL=https://app.myvirtualtracker.com

# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://auth.myvirtualtracker.com/api/auth/google/callback
# GOOGLE_OAUTH_STATE_SECRET=
# DASHBOARD_API_URL=https://appapi.myvirtualtracker.com

# ── Optional (rarely needed for Auth-Backend) ────────────────────────────────

# ALLOW_INSECURE_HTTP=true          # dev only — disable HTTPS enforcement
# SKIP_ENV_VALIDATION=1              # tests only — skip Zod env check
# GOOGLE_APPLICATION_CREDENTIALS=    # path to service account JSON file
# FIREBASE_DATABASE_URL=             # only if Admin SDK init requires RTDB URL
