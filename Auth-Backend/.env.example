# Copy the #Local DEV or #Production block into Auth-Backend/.env (never commit .env).
#
# AuthN only — Firebase token/credential APIs. No SMTP, no Firestore, no app email.
# Verification email, profile, session-bootstrap → Dashboard-Backend/.env.example

#Local DEV

NODE_ENV=development
PORT=5712

# CORS — allowed browser origins (defaults include Dashboard + Landing dev URLs)
FRONTEND_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Firebase Web (public client config) — or firebase-web.local.json
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# Firebase Admin — prefer firebase-admin.local.json (see *.example files)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Rate limiting (in-memory per process — see src/http/rate-limit.js)
# /api/auth/* → 25 req/min/IP; validate-password → 40; loopback exempt in dev

#Production
# Coolify: container vt-auth-api, domain auth.myvirtualtracker.com

# NODE_ENV=production
# PORT=3000

# FRONTEND_ORIGIN=https://app.myvirtualtracker.com
# APP_PUBLIC_URL=https://app.myvirtualtracker.com
# CORS_ORIGINS=https://app.myvirtualtracker.com,https://myvirtualtracker.com

# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
