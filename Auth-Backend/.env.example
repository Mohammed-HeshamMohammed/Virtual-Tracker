# Required ΓÇö set in Coolify environment variables
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public dashboard URL (https) ΓÇö used for CORS and email links
APP_PUBLIC_URL=https://app.yourdomain.com
FRONTEND_ORIGIN=https://app.yourdomain.com
# Optional comma-separated list if multiple origins are needed
# CORS_ORIGINS=https://app.yourdomain.com

# Firebase web (public client config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin ΓÇö use one method:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# or:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email (Resend or SMTP ΓÇö at least one required in production)
RESEND_API_KEY=
RESEND_FROM=Virtual Tracker <noreply@yourdomain.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional
# FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=
# FIREBASE_DATABASE_URL=
# SUPPORT_EMAIL=support@yourdomain.com
