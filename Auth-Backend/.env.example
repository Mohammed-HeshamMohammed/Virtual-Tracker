# Copy ONE block below into Auth-Backend/.env (never commit .env).
#
# AuthN only — six routes + /health (see README.md, authn-paths.js).
# No SMTP, Resend, phone OTP, VAPID, or app email on this service.
# Profile, session-bootstrap, verification email → Dashboard-Backend/.env.example
#
# Firebase files (alternative to FIREBASE_* below):
#   firebase-web.local.json   ← copy from firebase-web.local.json.example
#   firebase-admin.local.json ← copy from firebase-admin.local.json.example
#
# Rate limits (code defaults — not env vars): src/http/rate-limit.js
#   /api/auth/* → 25 req/min/IP; validate-password → 40; loopback exempt in dev

# ── Local DEV ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5712

# CORS — browser origins allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
# Optional override (defaults include Dashboard + Landing on :3000 / :3001 and 127.0.0.1)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Firebase Web — required for GET /api/auth/firebase-config (unless firebase-web.local.json)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# Firebase Admin — required for verify, resolve-sign-in-methods, readiness
# (unless firebase-admin.local.json or GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Or single-line JSON:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Production (Coolify: branch Auth-Production, vt-auth-api, auth.myvirtualtracker.com) ──

# NODE_ENV=production
# PORT=3000

# APP_PUBLIC_URL and FRONTEND_ORIGIN must be https in production
# FRONTEND_ORIGIN=https://app.myvirtualtracker.com
# APP_PUBLIC_URL=https://app.myvirtualtracker.com
# CORS_ORIGINS=https://app.myvirtualtracker.com,https://myvirtualtracker.com

# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Optional (rarely needed for Auth-Backend) ────────────────────────────────

# ALLOW_INSECURE_HTTP=true          # dev only — disable HTTPS enforcement
# SKIP_ENV_VALIDATION=1              # tests only — skip Zod env check
# GOOGLE_APPLICATION_CREDENTIALS=    # path to service account JSON file
# FIREBASE_DATABASE_URL=             # only if Admin SDK init requires RTDB URL
