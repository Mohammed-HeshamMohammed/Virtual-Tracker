# Copy the #Local DEV or #Production block into Auth-Backend/.env (never commit .env).
#
# AuthN-only service: Firebase config, token verify, password policy, verification email.
# Profile, session-bootstrap, phone OTP, deactivation → Dashboard-Backend/.env.example
# Platform URLs: src/config/deployment-profiles.js

#Local DEV

NODE_ENV=development
PORT=5712

# Dashboard Web — verification email links + primary CORS origin
APP_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# CORS defaults to Dashboard Web + Landing Web (override if needed)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Firebase Web (public client config) — or firebase-web.local.json
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# Firebase Admin — prefer firebase-admin.local.json (see *.example files)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Email (optional in development — required in production for send-verification-email)
# RESEND_API_KEY=
# RESEND_FROM=Virtual Tracker <onboarding@resend.dev>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional — included in GET /api/auth/firebase-config (phone OTP endpoints are on Dashboard-Backend)
# FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=
# PHONE_VERIFICATION_DEV_MODE=true

#Production
# Coolify: container vt-auth-api, domain auth.myvirtualtracker.com

# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0

# This service (documentation — not read by env schema)
# AUTH_PUBLIC_URL=https://auth.myvirtualtracker.com

# Dashboard Web — verification email links + primary CORS origin
# APP_PUBLIC_URL=https://app.myvirtualtracker.com
# FRONTEND_ORIGIN=https://app.myvirtualtracker.com

# CORS defaults to Dashboard Web + Landing Web (override if needed)
# CORS_ORIGINS=https://app.myvirtualtracker.com,https://myvirtualtracker.com

# Firebase Web (public client config)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# Firebase Admin — use one method:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Email (Resend or SMTP — at least one required in production)
# RESEND_API_KEY=
# RESEND_FROM=Virtual Tracker <noreply@myvirtualtracker.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional
# FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=
# PHONE_VERIFICATION_DEV_MODE=false
